/**
 * Defines the complete RentHub database structure.
 * Covers users, properties, amenities, favourites, comments and inquiries.
 */

generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  TENANT
  LANDLORD
}

enum PropertyType {
  APARTMENT
  BUILDING
}

enum LeaseType {
  LONG_TERM
  SHORT_TERM
  BOTH
}

enum PriceMode {
  PER_MONTH
  UTILITIES_INCLUDED
}

enum FurnishingStatus {
  FURNISHED
  UNFURNISHED
}

enum VegetarianPreference {
  VEGETARIAN_ONLY
  NO_PREFERENCE
}

enum PropertyStatus {
  ACTIVE
  INACTIVE
  RENTED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  properties        Property[]
  favourites        Favourite[]
  comments          Comment[]
  sentInquiries     Inquiry[]   @relation("InquirySender")
  receivedInquiries Inquiry[]   @relation("InquiryRecipient")
}

model Property {
  id                   String               @id @default(uuid()) @db.Uuid
  propertyType         PropertyType
  propertyName         String
  sharedProperty       Boolean              @default(false)
  address              String
  area                 String
  city                 String
  state                String
  postalCode           String
  squareFeet           Int
  leaseType            LeaseType
  monthlyRent          Decimal              @db.Decimal(12, 2)
  isNegotiable         Boolean              @default(false)
  priceMode            PriceMode            @default(PER_MONTH)
  furnishingStatus     FurnishingStatus
  vegetarianPreference VegetarianPreference @default(NO_PREFERENCE)
  contactPhone         String?
  title                String
  description          String               @db.VarChar(1400)
  status               PropertyStatus       @default(ACTIVE)
  ownerId              String               @db.Uuid
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  owner      User              @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  images     PropertyImage[]
  amenities  PropertyAmenity[]
  favourites Favourite[]
  comments   Comment[]
  inquiries  Inquiry[]

  @@index([city, area])
  @@index([monthlyRent])
  @@index([leaseType, furnishingStatus])
  @@index([propertyType])
  @@index([status, createdAt])
  @@index([status, monthlyRent])
  @@index([status, propertyType])
  @@index([ownerId, createdAt])
}

model PropertyImage {
  id         String   @id @default(uuid()) @db.Uuid
  imageUrl   String
  publicId   String
  position   Int      @default(0)
  propertyId String   @db.Uuid
  createdAt  DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, position])
}

model Amenity {
  id         String            @id @default(uuid()) @db.Uuid
  name       String            @unique
  properties PropertyAmenity[]
}

model PropertyAmenity {
  propertyId String @db.Uuid
  amenityId  String @db.Uuid

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amenity  Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([propertyId, amenityId])
  @@index([amenityId])
}

model Favourite {
  userId     String   @db.Uuid
  propertyId String   @db.Uuid
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@id([userId, propertyId])
  @@index([propertyId])
  @@index([userId, createdAt])
}

model Comment {
  id         String   @id @default(uuid()) @db.Uuid
  content    String
  userId     String   @db.Uuid
  propertyId String   @db.Uuid
  parentId   String?  @db.Uuid
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentReplies")

  @@index([propertyId, createdAt])
  @@index([parentId, createdAt])
}

model Inquiry {
  id          String   @id @default(uuid()) @db.Uuid
  message     String
  senderId    String   @db.Uuid
  recipientId String   @db.Uuid
  propertyId  String   @db.Uuid
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  sender    User     @relation("InquirySender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User     @relation("InquiryRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  property  Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([recipientId, isRead, createdAt])
  @@index([senderId, createdAt])
  @@index([propertyId])
}
